<script>
// ─── CURSOR ───
const C = document.getElementById('C');
const CR = document.getElementById('CR');
let mx=0,my=0,rx=0,ry=0;
document.addEventListener('mousemove',e=>{mx=e.clientX;my=e.clientY;C.style.left=mx+'px';C.style.top=my+'px'});
(function loop(){rx+=(mx-rx)*.11;ry+=(my-ry)*.11;CR.style.left=rx+'px';CR.style.top=ry+'px';requestAnimationFrame(loop)})();
document.querySelectorAll('a,button').forEach(el=>{
  el.addEventListener('mouseenter',()=>{C.style.width='18px';C.style.height='18px';CR.style.width='60px';CR.style.height='60px'});
  el.addEventListener('mouseleave',()=>{C.style.width='8px';C.style.height='8px';CR.style.width='40px';CR.style.height='40px'});
});

// ─── STARS ───
const sc=document.getElementById('SC');
const cx=sc.getContext('2d');
function resize(){sc.width=innerWidth;sc.height=innerHeight}resize();
window.addEventListener('resize',resize);

class Star{
  constructor(){this.reset()}
  reset(){
    this.x=Math.random()*sc.width;
    this.y=Math.random()*sc.height;
    this.r=Math.random()*1.3+.1;
    this.a=Math.random()*.8+.05;
    this.ba=this.a;
    this.sp=Math.random()*.5+.05;
    this.ph=Math.random()*Math.PI*2;
    this.gold=Math.random()>.94;
  }
  update(t){
    this.a=this.ba*(.4+.6*Math.sin(t*this.sp+this.ph));
    this.y-=.06;
    if(this.y<-2){this.y=sc.height+2;this.x=Math.random()*sc.width}
  }
  draw(){
    cx.beginPath();
    cx.arc(this.x,this.y,this.r,0,Math.PI*2);
    cx.fillStyle=this.gold?'#b8914a':'#ffffff';
    cx.globalAlpha=this.a;
    cx.fill();
  }
}

class Shooter{
  constructor(){this.reset();this.active=false}
  reset(){
    this.x=Math.random()*sc.width*.8+sc.width*.1;
    this.y=Math.random()*sc.height*.3;
    this.vx=Math.random()*3+1.5;
    this.vy=Math.random()*1.5+.8;
    this.life=0;this.maxL=Math.random()*70+50;
    this.a=0;this.active=false;
  }
  update(){
    if(!this.active)return;
    this.life++;
    this.x+=this.vx;this.y+=this.vy;
    this.a=this.life<25?this.life/25:(this.maxL-this.life)/(this.maxL-25);
    if(this.life>=this.maxL)this.reset();
  }
  draw(){
    if(!this.active||this.a<=0)return;
    cx.save();cx.globalAlpha=this.a*.9;
    const g=cx.createLinearGradient(this.x,this.y,this.x-this.vx*9,this.y-this.vy*9);
    g.addColorStop(0,'#b8914a');g.addColorStop(1,'transparent');
    cx.strokeStyle=g;cx.lineWidth=1.5;
    cx.beginPath();cx.moveTo(this.x,this.y);
    cx.lineTo(this.x-this.vx*11,this.y-this.vy*11);
    cx.stroke();cx.restore();
  }
}

const stars=Array.from({length:350},()=>new Star());
const shooters=Array.from({length:3},()=>new Shooter());
let t=0,lastS=0;
function frame(){
  cx.clearRect(0,0,sc.width,sc.height);t+=.015;
  // Nebula
  const nb=cx.createRadialGradient(sc.width*.35,sc.height*.25,0,sc.width*.35,sc.height*.25,sc.width*.55);
  nb.addColorStop(0,'rgba(184,145,74,.018)');nb.addColorStop(1,'transparent');
  cx.fillStyle=nb;cx.globalAlpha=1;cx.fillRect(0,0,sc.width,sc.height);
  stars.forEach(s=>{s.update(t);s.draw()});
  cx.globalAlpha=1;
  if(t-lastS>5+Math.random()*10){
    const sh=shooters.find(s=>!s.active);if(sh){sh.reset();sh.active=true}
    lastS=t;
  }
  shooters.forEach(s=>{s.update();s.draw()});
  cx.globalAlpha=1;
  requestAnimationFrame(frame);
}
frame();

// ─── NAV ───
const nav=document.getElementById('nav');
addEventListener('scroll',()=>nav.classList.toggle('solid',scrollY>60));

// ─── HERO ───
const hbg=document.getElementById('hbg');
setTimeout(()=>hbg.classList.add('z'),100);
addEventListener('scroll',()=>{
  hbg.style.transform=`scale(1.06) translateY(${scrollY*.28}px)`;
  const rt=document.getElementById('rtbg');
  if(rt){
    const r=document.getElementById('rooftop').getBoundingClientRect();
    rt.style.transform=`scale(1.04) translateY(${r.top*.12}px)`;
  }
});

// ─── REVEAL ───
const rvEls=document.querySelectorAll('.rv,.rl,.rr');
const obs=new IntersectionObserver(entries=>{
  entries.forEach(e=>{if(e.isIntersecting)e.target.classList.add('on')});
},{threshold:.08,rootMargin:'0px 0px -50px 0px'});
rvEls.forEach(el=>obs.observe(el));

// ─── ANCHOR SMOOTH ───
document.querySelectorAll('a[href^="#"]').forEach(a=>{
  a.addEventListener('click',e=>{
    const t=document.querySelector(a.getAttribute('href'));
    if(t){e.preventDefault();t.scrollIntoView({behavior:'smooth'})}
  });
});
</script>
</body>
</html>
/* AWWWARDS-TIER LANGUAGE SELECTOR (MIDDLE-TOP) */
.lang-container {
    position: absolute;
    top: 30px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 999999;
    display: flex;
    align-items: center;
    gap: 15px;
    font-family: 'Cinzel', serif;
}

.lang-link {
    font-size: 11px;
    letter-spacing: 4px;
    text-transform: uppercase;
    cursor: pointer;
    color: #ffffff;
    opacity: 0.25;
    position: relative;
    padding: 4px 0;
    transition: opacity 0.6s cubic-bezier(0.25, 1, 0.5, 1), text-shadow 0.6s ease;
}

.lang-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 0;
    height: 0.5px;
    background: #d4af37;
    transition: width 0.6s cubic-bezier(0.25, 1, 0.5, 1), left 0.6s cubic-bezier(0.25, 1, 0.5, 1);
}

.lang-link:hover, .lang-link.active {
    opacity: 1;
    color: #fff;
    text-shadow: 0 0 12px rgba(212, 175, 55, 0.4);
}

.lang-link.active::after {
    width: 100%;
    left: 0;
}

.lang-divider {
    font-size: 10px;
    color: rgba(212, 175, 55, 0.15);
    user-select: none;
}

/* KINETIC 3D GLASS AI CONCIERGE */
.chat-widget-container {
    position: fixed;
    bottom: 40px;
    right: 40px;
    z-index: 999999;
    perspective: 1200px;
}

.chat-button-trigger {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: rgba(15, 15, 15, 0.6);
    backdrop-filter: blur(40px);
    -webkit-backdrop-filter: blur(40px);
    border: 0.5px solid rgba(212, 175, 55, 0.25);
    color: #d4af37;
    font-size: 18px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
    transition: all 0.5s cubic-bezier(0.25, 1, 0.5, 1);
}

.chat-button-trigger:hover {
    border-color: rgba(212, 175, 55, 0.6);
    transform: scale(1.05) rotate(15deg);
}

.chat-box-window {
    display: flex;
    visibility: hidden;
    opacity: 0;
    position: fixed;
    bottom: 110px;
    right: 40px;
    width: 340px;
    height: 480px;
    background: linear-gradient(180deg, rgba(10, 10, 10, 0.75), rgba(5, 5, 5, 0.9));
    backdrop-filter: blur(50px);
    -webkit-backdrop-filter: blur(50px);
    border: 0.5px solid rgba(212, 175, 55, 0.15);
    border-radius: 20px;
    flex-direction: column;
    overflow: hidden;
    box-shadow: 0 30px 70px rgba(0,0,0,0.8);
    
    /* 3D Скъпо изглеждащо отваряне */
    transform: translateY(30px) scale(0.92) rotateX(-15deg) rotateY(10deg);
    transform-origin: bottom right;
    transition: transform 0.7s cubic-bezier(0.25, 1, 0.5, 1), opacity 0.6s cubic-bezier(0.25, 1, 0.5, 1), visibility 0.6s;
}

.chat-box-window.luxury-open {
    visibility: visible;
    opacity: 1;
    transform: translateY(0) scale(1) rotateX(0) rotateY(0);
}

.chat-box-header {
    padding: 22px;
    color: #fff;
    font-family: 'Cinzel', serif;
    font-size: 13px;
    letter-spacing: 2px;
    text-transform: uppercase;
    border-bottom: 1px solid rgba(255, 255, 255, 0.03);
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.chat-box-close {
    background: none;
    border: none;
    color: rgba(255,255,255,0.3);
    cursor: pointer;
    font-size: 22px;
}

.chat-box-body {
    flex: 1;
    padding: 22px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.chat-bubble {
    padding: 14px 18px;
    border-radius: 14px;
    max-width: 85%;
    font-size: 12px;
    line-height: 1.6;
    font-family: 'Montserrat', sans-serif;
}

.bubble-bot {
    background: rgba(255, 255, 255, 0.03);
    color: #d1d1d1;
    align-self: flex-start;
    border: 0.5px solid rgba(255,255,255,0.05);
}

.bubble-user {
    background: rgba(212, 175, 55, 0.08);
    color: #fff;
    border: 0.5px solid rgba(212, 175, 55, 0.25);
    align-self: flex-end;
}

.chat-box-options {
    padding: 16px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    border-top: 1px solid rgba(255, 255, 255, 0.03);
}

.option-click-btn {
    background: rgba(255, 255, 255, 0.01);
    border: 0.5px solid rgba(255, 255, 255, 0.08);
    color: #b5b5b5;
    padding: 8px 16px;
    border-radius: 30px;
    cursor: pointer;
    font-size: 11px;
    transition: all 0.4s ease;
}

.option-click-btn:hover {
    border-color: #d4af37;
    color: #fff;
    background: rgba(212, 175, 55, 0.03);
}<div class="lang-container">
    <span class="lang-link active" id="btn-bg" onclick="changeSiteLang('bg')">BG</span>
    <span class="lang-divider">/</span>
    <span class="lang-link" id="btn-en" onclick="changeSiteLang('en')">EN</span>
</div>

<div class="chat-widget-container">
    <button class="chat-button-trigger" onclick="toggleChatWindow()">✨</button>
    <div class="chat-box-window" id="hotelChatWindow">
        <div class="chat-box-header">
            <span id="chatTitle">Рецепция Персенк</span>
            <button class="chat-box-close" onclick="toggleChatWindow()">×</button>
        </div>
        <div class="chat-box-body" id="hotelChatBody">
            <div class="chat-bubble bubble-bot" id="chatGreet">
                Здравейте! Добре дошли в петзвездния СПА Хотел Персенк. С какво мога да улесня престоя Ви днес?
            </div>
        </div>
        <div class="chat-box-options" id="hotelChatOptions"></div>
    </div>
</div>
let activeLanguage = 'bg';

const dictionary = {
    "Начало": "Home",
    "За нас": "About Us",
    "Стаи": "Rooms",
    "СПА Център": "SPA Center",
    "Контакти": "Contacts"
};

const botBrain = {
    bg: [
        { q: "💎 Минерална вода", a: "Хотелът разполага с директна девинска минерална вода във всички басейни." },
        { q: "👑 Термална зона", a: "На разположение са финландска сауна, парна баня, джакузи и спа ритуали." },
        { q: "🥂 VIP Настаняване", a: "За резервации на премиум апартаменти, моля свържете се с нас директно." }
    ],
    en: [
        { q: "💎 Mineral Water", a: "The hotel features direct natural Devin mineral water in all swimming pools." },
        { q: "👑 Thermal Zone", a: "Indulge in our Finnish sauna, steam baths, jacuzzi, and wellness treatments." },
        { q: "🥂 VIP Suites", a: "For exclusive suite availability, please contact our concierge directly." }
    ]
};

function toggleChatWindow() {
    const w = document.getElementById('hotelChatWindow');
    w.classList.toggle('luxury-open');
    if(w.classList.contains('luxury-open')) renderChatOptions();
}

function renderChatOptions() {
    const container = document.getElementById('hotelChatOptions');
    container.innerHTML = '';
    botBrain[activeLanguage].forEach(item => {
        const b = document.createElement('button');
        b.className = 'option-click-btn';
        b.innerText = item.q;
        b.onclick = () => askBot(item.q, item.a);
        container.appendChild(b);
    });
}

function askBot(question, answer) {
    const body = document.getElementById('hotelChatBody');
    const uDiv = document.createElement('div');
    uDiv.className = 'chat-bubble bubble-user';
    uDiv.innerText = question;
    body.appendChild(uDiv);
    
    setTimeout(() => {
        const bDiv = document.createElement('div');
        bDiv.className = 'chat-bubble bubble-bot';
        bDiv.innerText = answer;
        body.appendChild(bDiv);
        body.scrollTop = body.scrollHeight;
    }, 450); 
}

function changeSiteLang(lang) {
    activeLanguage = lang;
    document.getElementById('btn-bg').classList.remove('active');
    document.getElementById('btn-en').classList.remove('active');
    document.getElementById('btn-' + lang).classList.add('active');
    
    const title = document.getElementById('chatTitle');
    const greet = document.getElementById('chatGreet');
    
    if(lang === 'en') {
        title.innerText = "Persenk Concierge";
        greet.innerText = "Welcome to the five-star Spa Hotel Persenk. How may I assist you today?";
    } else {
        title.innerText = "Рецепция Персенк";
        greet.innerText = "Здравейте! Добре дошли в петзвездния СПА Хотел Персенк. С какво мога да улесня престоя Ви днес?";
    }
    renderChatOptions();

    const links = document.querySelectorAll('nav ul li a');
    links.forEach(el => {
        let text = el.innerText.trim();
        if (lang === 'en') {
            if (dictionary[text]) {
                if (!el.getAttribute('data-orig')) el.setAttribute('data-orig', text);
                el.innerText = dictionary[text];
            }
        } else {
            if (el.getAttribute('data-orig')) el.innerText = el.getAttribute('data-orig');
        }
    });
}


