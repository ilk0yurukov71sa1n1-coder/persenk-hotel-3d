<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>PERSENK — Five Star Spa Hotel · Rhodope Mountains</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Didact+Gothic&family=Cinzel+Decorative:wght@400;700&family=Cinzel:wght@400;500;600;700&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400;1,500&family=Montserrat:wght@100;200;300;400&display=swap" rel="stylesheet">
<style>
:root {
  --g: #b8914a;
  --gl: #d4ac6e;
  --gp: rgba(184,145,74,0.12);
  --gd: rgba(184,145,74,0.04);
  --k: #05050c;
  --k2: #0a0a14;
  --k3: #0f0f1c;
  --w: #f0ead8;
  --wm: rgba(240,234,216,0.5);
  --wf: rgba(240,234,216,0.25);
}

*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;font-size:16px}
body{
  background:var(--k);
  color:var(--w);
  font-family:'Montserrat',sans-serif;
  font-weight:200;
  overflow-x:hidden;
  cursor:none;
}

/* ═══ CURSOR ═══ */
#C{position:fixed;width:8px;height:8px;background:var(--g);border-radius:50%;pointer-events:none;z-index:9999;transform:translate(-50%,-50%);mix-blend-mode:screen;transition:width .25s,height .25s}
#CR{position:fixed;width:40px;height:40px;border:1px solid rgba(184,145,74,.5);border-radius:50%;pointer-events:none;z-index:9998;transform:translate(-50%,-50%);transition:width .3s,height .3s}
body:hover #C{opacity:1}

/* ═══ STARS ═══ */
#SC{position:fixed;inset:0;z-index:0;pointer-events:none}

/* ═══ GRAIN ═══ */
body::before{
  content:'';position:fixed;inset:0;
  background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.75' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.035'/%3E%3C/svg%3E");
  pointer-events:none;z-index:1;
}

/* ═══ MAIN ═══ */
main{position:relative;z-index:2}

/* ═══ NAV ═══ */
nav{
  position:fixed;top:0;left:0;right:0;z-index:200;
  display:flex;align-items:center;justify-content:space-between;
  padding:28px 64px;
  transition:all .6s cubic-bezier(.22,1,.36,1);
}
nav.solid{
  background:rgba(5,5,12,.92);
  backdrop-filter:blur(24px);
  padding:16px 64px;
  border-bottom:1px solid rgba(184,145,74,.1);
}
.nl{display:flex;gap:36px;list-style:none}
.nl a{
  font-family:'Cinzel',serif;font-size:9px;letter-spacing:3.5px;
  text-decoration:none;color:rgba(240,234,216,.6);text-transform:uppercase;
  transition:color .3s;
}
.nl a:hover{color:var(--g)}
.nb{
  font-family:'Cinzel',serif;font-size:9px;letter-spacing:3px;
  text-decoration:none;color:var(--k);background:var(--g);
  padding:12px 28px;text-transform:uppercase;
  transition:background .3s,transform .3s,box-shadow .3s;
}
.nb:hover{background:var(--gl);transform:translateY(-1px);box-shadow:0 8px 32px rgba(184,145,74,.3)}
.nlogo{
  font-family:'Cinzel Decorative',serif;font-size:16px;letter-spacing:4px;
  color:var(--g);text-decoration:none;
}

/* ═══ HERO ═══ */
#hero{
  height:100vh;position:relative;overflow:hidden;
  display:flex;align-items:flex-end;justify-content:flex-start;
}
#hbg{
  position:absolute;inset:0;
  background:url('data:image/jpeg;base64,') center 60%/cover no-repeat;
  filter:brightness(.35) saturate(.65);
  transform:scale(1.06);
  transition:transform 14s ease;
}
#hbg.z{transform:scale(1)}
.hvig{
  position:absolute;inset:0;
  background:linear-gradient(
    135deg,
    rgba(5,5,12,.95) 0%,
    rgba(5,5,12,.5) 40%,
    rgba(5,5,12,.15) 70%,
    rgba(5,5,12,.6) 100%
  );
}
.hc{
  position:relative;z-index:3;
  padding:0 80px 80px;
  max-width:900px;
}
.ht-eyebrow{
  font-family:'Cinzel',serif;font-size:9px;letter-spacing:8px;
  color:var(--g);text-transform:uppercase;margin-bottom:24px;
  display:flex;align-items:center;gap:16px;
  opacity:0;transform:translateX(-24px);
  animation:sli .9s .3s forwards;
}
.ht-eyebrow::before{content:'';width:40px;height:1px;background:var(--g)}
.ht{
  font-family:'Cormorant Garamond',serif;
  font-size:clamp(72px,10vw,148px);
  font-weight:300;line-height:.88;
  letter-spacing:-3px;
  opacity:0;transform:translateY(40px);
  animation:fup 1.1s .5s forwards;
}
.ht em{
  font-style:italic;color:var(--gl);display:block;
  font-size:clamp(52px,7.5vw,112px);
}
.ht-sub{
  margin-top:32px;
  font-size:11px;letter-spacing:5px;color:var(--wm);text-transform:uppercase;
  opacity:0;animation:fup .8s 1s forwards;
}
.ht-line{
  margin-top:40px;display:flex;align-items:center;gap:20px;
  opacity:0;animation:fup .7s 1.3s forwards;
}
.ht-line span{
  font-family:'Cinzel',serif;font-size:8px;letter-spacing:4px;color:var(--g);
  text-transform:uppercase;
}
.ht-line::before,.ht-line::after{
  content:'';flex:1;max-width:60px;height:1px;background:rgba(184,145,74,.4);
}
.hscroll{
  position:absolute;right:48px;bottom:40px;z-index:3;
  display:flex;flex-direction:column;align-items:center;gap:10px;
  opacity:0;animation:fup .6s 1.8s forwards;
}
.hscroll span{
  font-family:'Cinzel',serif;font-size:7px;letter-spacing:4px;
  color:var(--wf);writing-mode:vertical-rl;
}
.hscroll-line{
  width:1px;height:56px;
  background:linear-gradient(to bottom,var(--g),transparent);
  animation:pulse 2.2s infinite;
}
@keyframes pulse{0%,100%{opacity:.2;transform:scaleY(1)}50%{opacity:1;transform:scaleY(.6)}}

/* ═══ TICKER ═══ */
.ticker{
  overflow:hidden;border-top:1px solid rgba(184,145,74,.08);
  border-bottom:1px solid rgba(184,145,74,.08);
  padding:13px 0;
  background:rgba(5,5,12,.6);
}
.ticker-t{
  display:flex;white-space:nowrap;gap:0;
  animation:tick 28s linear infinite;
}
.ticker-t span{
  font-family:'Cinzel',serif;font-size:8px;letter-spacing:6px;
  color:var(--g);text-transform:uppercase;padding:0 56px;
}
.ticker-t span::after{content:'◆';margin-left:56px;opacity:.4}
@keyframes tick{from{transform:translateX(0)}to{transform:translateX(-50%)}}

/* ═══ SECTION BASE ═══ */
section{padding:130px 0;position:relative}
.W{max-width:1280px;margin:0 auto;padding:0 64px}
.eyebrow{
  font-family:'Cinzel',serif;font-size:8px;letter-spacing:6px;
  color:var(--g);text-transform:uppercase;margin-bottom:18px;
  display:flex;align-items:center;gap:14px;
}
.eyebrow::before{content:'';width:28px;height:1px;background:var(--g)}
.H{
  font-family:'Cormorant Garamond',serif;
  font-size:clamp(44px,5.5vw,80px);
  font-weight:300;line-height:1.0;
}
.H em{font-style:italic;color:var(--gl)}
.body{font-size:14px;line-height:1.9;color:var(--wm);max-width:520px}

/* ═══ REVEAL ═══ */
.rv{opacity:0;transform:translateY(52px);transition:opacity .95s cubic-bezier(.22,1,.36,1),transform .95s cubic-bezier(.22,1,.36,1)}
.rl{opacity:0;transform:translateX(-56px);transition:opacity .95s cubic-bezier(.22,1,.36,1),transform .95s cubic-bezier(.22,1,.36,1)}
.rr{opacity:0;transform:translateX(56px);transition:opacity .95s cubic-bezier(.22,1,.36,1),transform .95s cubic-bezier(.22,1,.36,1)}
.vs,.vs2,.vs3,.vs4,.vs5{opacity:1!important;transform:none!important}
.rv.on,.rl.on,.rr.on{opacity:1;transform:none}
.d1{transition-delay:.08s!important}
.d2{transition-delay:.18s!important}
.d3{transition-delay:.28s!important}
.d4{transition-delay:.38s!important}
.d5{transition-delay:.50s!important}

/* ═══ ENTRANCE — BRAND MOMENT ═══ */
#entrance{padding:0;overflow:hidden}
.ent-grid{
  display:grid;
  grid-template-columns:45% 55%;
  min-height:80vh;
}
.ent-img{
  position:relative;overflow:hidden;
}
.ent-img img{
  width:100%;height:100%;object-fit:cover;
  filter:brightness(.75) saturate(.85);
  transition:transform 8s ease,filter .6s;
}
.ent-img:hover img{transform:scale(1.04);filter:brightness(.88) saturate(1)}
.ent-content{
  background:var(--k2);
  display:flex;flex-direction:column;justify-content:center;
  padding:80px 72px;
  border-left:1px solid rgba(184,145,74,.07);
}
.ent-stars{
  font-size:22px;letter-spacing:8px;color:var(--g);
  margin-bottom:32px;
}
.ent-quote{
  font-family:'Cormorant Garamond',serif;
  font-size:clamp(28px,3vw,44px);
  font-style:italic;font-weight:300;
  line-height:1.25;color:var(--w);
  margin-bottom:32px;
}
.ent-quote em{color:var(--gl);font-style:normal}
.ent-body{
  font-size:13px;line-height:1.85;color:var(--wm);
  border-left:2px solid rgba(184,145,74,.3);
  padding-left:20px;
}
.ent-stats{
  display:flex;gap:48px;margin-top:48px;padding-top:32px;
  border-top:1px solid rgba(184,145,74,.12);
}
.es{}
.es-n{
  font-family:'Cormorant Garamond',serif;font-size:56px;
  font-weight:300;color:var(--g);line-height:1;
}
.es-l{
  font-family:'Cinzel',serif;font-size:7px;letter-spacing:3px;
  color:var(--wf);text-transform:uppercase;margin-top:6px;
}

/* ═══ LOBBY ═══ */
#lobby{padding:0;position:relative}
.lobby-full{
  height:75vh;position:relative;overflow:hidden;
}
.lobby-full img{
  width:100%;height:100%;object-fit:cover;
  filter:brightness(.55) saturate(.7);
  transition:transform 10s ease;
}
.lobby-full:hover img{transform:scale(1.03)}
.lobby-over{
  position:absolute;inset:0;
  display:flex;align-items:center;justify-content:center;
  background:linear-gradient(to top,rgba(5,5,12,.9) 0%,transparent 60%);
}
.lobby-title{
  position:absolute;bottom:60px;left:80px;
}
.lobby-badge{
  position:absolute;top:40px;right:40px;
  width:120px;height:120px;
  border:1px solid rgba(184,145,74,.35);
  border-radius:50%;
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  background:rgba(5,5,12,.6);backdrop-filter:blur(10px);
}
.lb-n{font-family:'Cormorant Garamond',serif;font-size:32px;color:var(--g);line-height:1}
.lb-l{font-family:'Cinzel',serif;font-size:6px;letter-spacing:2px;color:var(--wf);text-transform:uppercase;margin-top:4px;text-align:center}

/* ═══ ROOMS ═══ */
#rooms{background:linear-gradient(180deg,transparent,rgba(184,145,74,.025),transparent)}
.rooms-l{
  display:grid;grid-template-columns:1fr 1fr;
  gap:80px;align-items:center;margin-bottom:72px;
}
.room-hero{
  position:relative;overflow:hidden;
}
.room-hero::before{
  content:'';position:absolute;
  top:-24px;left:-24px;right:24px;bottom:24px;
  border:1px solid rgba(184,145,74,.2);
  pointer-events:none;z-index:2;
}
.room-hero img{
  width:100%;height:580px;object-fit:cover;
  filter:brightness(.8) saturate(.8);
  display:block;
  transition:filter .5s,transform 6s ease;
}
.room-hero:hover img{filter:brightness(.93) saturate(1);transform:scale(1.03)}
.room-tag{
  position:absolute;bottom:0;left:0;
  background:var(--g);color:var(--k);
  font-family:'Cinzel',serif;font-size:7px;letter-spacing:4px;
  padding:12px 22px;text-transform:uppercase;z-index:3;
}
.room-feats{
  display:flex;flex-direction:column;gap:0;margin-top:40px;
}
.rf{
  display:flex;align-items:center;gap:16px;
  padding:16px 0;border-bottom:1px solid rgba(184,145,74,.07);
  font-size:12px;color:var(--wm);
}
.rf::before{
  content:'';width:4px;height:4px;background:var(--g);
  border-radius:50%;flex-shrink:0;
}

/* ═══ SPA CENTER ═══ */
#spa{padding:0;overflow:hidden}
.spa-hero{
  height:70vh;position:relative;overflow:hidden;
  display:flex;align-items:center;
}
.spa-hero-bg{
  position:absolute;inset:0;
  background:url('data:image/jpeg;base64,') center/cover;
  filter:brightness(.3) saturate(.6);
}
.spa-hero-content{
  position:relative;z-index:2;padding:0 80px;
}
.spa-panels{
  display:grid;grid-template-columns:repeat(4,1fr);gap:2px;
  background:var(--k);
}
.spa-panel{
  position:relative;overflow:hidden;height:420px;cursor:none;
}
.spa-panel img{
  width:100%;height:100%;object-fit:cover;
  filter:brightness(.5) saturate(.65);
  transition:transform .7s cubic-bezier(.22,1,.36,1),filter .5s;
}
.spa-panel:hover img{
  transform:scale(1.08);filter:brightness(.72) saturate(1);
}
.spa-panel-over{
  position:absolute;inset:0;
  background:linear-gradient(to top,rgba(5,5,12,.92) 0%,transparent 55%);
  display:flex;flex-direction:column;justify-content:flex-end;
  padding:28px 24px;
}
.sp-eyebrow{
  font-family:'Cinzel',serif;font-size:7px;letter-spacing:4px;
  color:var(--g);text-transform:uppercase;margin-bottom:8px;
}
.sp-name{
  font-family:'Cormorant Garamond',serif;font-size:22px;
  font-weight:300;line-height:1.2;
}
.sp-desc{
  font-size:11px;color:var(--wm);line-height:1.6;
  margin-top:8px;
  opacity:0;transform:translateY(10px);
  transition:opacity .4s,transform .4s;
}
.spa-panel:hover .sp-desc{opacity:1;transform:translateY(0)}

/* ═══ SPLIT REVEAL — POOL ═══ */
#pool{padding:0;overflow:hidden}
.pool-split{
  display:grid;grid-template-columns:55% 45%;
  min-height:680px;
}
.ps-img{position:relative;overflow:hidden}
.ps-img img{
  width:100%;height:100%;object-fit:cover;
  filter:brightness(.7) saturate(.8);
  transition:transform 8s ease;
}
.ps-img:hover img{transform:scale(1.04)}
.ps-content{
  background:var(--k2);
  display:flex;flex-direction:column;justify-content:center;
  padding:72px 64px;
  border-left:1px solid rgba(184,145,74,.07);
}
.ps-detail{
  display:flex;flex-direction:column;gap:0;margin-top:36px;
}
.pd{
  display:flex;align-items:center;gap:18px;
  padding:18px 0;border-bottom:1px solid rgba(184,145,74,.07);
  font-size:13px;color:var(--wm);
}
.pd:last-child{border:none}
.pd-icon{
  width:38px;height:38px;border:1px solid rgba(184,145,74,.25);
  border-radius:50%;display:flex;align-items:center;justify-content:center;
  font-size:15px;flex-shrink:0;
}

/* ═══ DINING ═══ */
#dining{background:var(--k2)}
.dining-intro{
  display:grid;grid-template-columns:1fr 1fr;gap:80px;
  align-items:end;margin-bottom:72px;
}
.dining-mosaic{
  display:grid;
  grid-template-columns:1fr 1fr 1fr;
  grid-template-rows:320px 320px;
  gap:3px;
}
.dt{position:relative;overflow:hidden;cursor:none}
.dt:nth-child(1){grid-column:span 2;grid-row:span 2}
.dt img{
  width:100%;height:100%;object-fit:cover;
  filter:brightness(.5) saturate(.65);
  transition:transform .7s cubic-bezier(.22,1,.36,1),filter .5s;
  display:block;
}
.dt:hover img{transform:scale(1.07);filter:brightness(.72) saturate(1)}
.dt-over{
  position:absolute;bottom:0;left:0;right:0;
  background:linear-gradient(to top,rgba(5,5,12,.88),transparent);
  padding:24px 22px 18px;
}
.dt-label{
  font-family:'Cormorant Garamond',serif;font-size:20px;font-weight:300;
}
.dt:nth-child(1) .dt-label{font-size:30px;padding:36px}
.dining-7{
  margin-top:56px;display:flex;align-items:flex-end;gap:24px;
}
.d7-num{
  font-family:'Cormorant Garamond',serif;
  font-size:clamp(100px,14vw,180px);
  font-weight:300;color:transparent;
  -webkit-text-stroke:1px rgba(184,145,74,.25);line-height:1;
}
.d7-text{
  padding-bottom:20px;
}
.d7-title{
  font-family:'Cormorant Garamond',serif;font-size:36px;
  font-weight:300;color:var(--gl);margin-bottom:8px;
}
.d7-sub{font-size:12px;color:var(--wm);line-height:1.7;max-width:280px}

/* ═══ ROOFTOP ═══ */
#rooftop{padding:0;position:relative;min-height:600px;display:flex;align-items:center;overflow:hidden}
#rtbg{
  position:absolute;inset:0;
  background:url('data:image/jpeg;base64,') center/cover;
  filter:brightness(.28) saturate(.6);
  transform:scale(1.04);
  transition:transform .1s;
}
.rt-content{
  position:relative;z-index:2;padding:80px;
  display:flex;gap:80px;align-items:center;width:100%;
}
.rt-left{flex:1;max-width:540px}
.rt-right{
  flex:1;display:flex;flex-direction:column;gap:24px;
}
.rt-feat{
  background:rgba(184,145,74,.06);border:1px solid rgba(184,145,74,.1);
  padding:24px 28px;display:flex;align-items:flex-start;gap:16px;
}
.rtf-icon{font-size:24px;flex-shrink:0}
.rtf-name{
  font-family:'Cinzel',serif;font-size:10px;letter-spacing:2px;
  color:var(--g);margin-bottom:6px;text-transform:uppercase;
}
.rtf-desc{font-size:12px;color:var(--wm);line-height:1.6}

/* ═══ NIGHT BAR ═══ */
#nightbar{padding:0;overflow:hidden}
.nb-split{display:grid;grid-template-columns:1fr 1fr;min-height:600px}
.nb-img{position:relative;overflow:hidden}
.nb-img img{
  width:100%;height:100%;object-fit:cover;
  filter:brightness(.6) saturate(.75);
  transition:transform .8s;
}
.nb-img:hover img{transform:scale(1.04)}
.nb-content{
  background:linear-gradient(135deg,rgba(184,145,74,.05),transparent);
  display:flex;flex-direction:column;justify-content:center;
  padding:80px 72px;
  border:1px solid rgba(184,145,74,.06);border-left:none;
}
.nb-list{
  display:flex;flex-direction:column;gap:0;margin-top:36px;
}
.nbl{
  display:flex;align-items:center;gap:14px;
  padding:14px 0;border-bottom:1px solid rgba(184,145,74,.07);
  font-size:13px;color:var(--wm);
}
.nbl::before{content:'◆';color:var(--g);font-size:7px;flex-shrink:0}

/* ═══ OFFERS ═══ */
#offers{background:var(--k)}
.offers-head{
  display:flex;align-items:flex-end;justify-content:space-between;
  margin-bottom:56px;
}
.offers-g{
  display:grid;grid-template-columns:repeat(3,1fr);
  border:1px solid rgba(184,145,74,.08);
  background:rgba(184,145,74,.04);gap:1px;
}
.oc{
  background:var(--k);padding:44px 36px;
  transition:background .4s;cursor:none;
}
.oc:hover{background:rgba(184,145,74,.04)}
.oc-tag{
  font-family:'Cinzel',serif;font-size:7px;letter-spacing:3px;
  color:var(--g);text-transform:uppercase;margin-bottom:18px;
  display:flex;align-items:center;gap:10px;
}
.oc-tag::before{content:'';width:16px;height:1px;background:var(--g)}
.oc-n{
  font-family:'Cormorant Garamond',serif;font-size:28px;
  font-weight:300;line-height:1.1;margin-bottom:14px;
}
.oc-d{font-size:12px;color:var(--wm);line-height:1.75;margin-bottom:28px}
.oc-link{
  font-family:'Cinzel',serif;font-size:7px;letter-spacing:3px;
  color:var(--g);text-decoration:none;text-transform:uppercase;
  display:flex;align-items:center;gap:12px;
}
.oc-link::after{content:'';flex:1;height:1px;background:var(--g);max-width:28px;transition:max-width .3s}
.oc:hover .oc-link::after{max-width:52px}

/* ═══ AMENITIES ═══ */
#amenities{background:var(--k2)}
.am-head{margin-bottom:64px;text-align:center}
.am-head .eyebrow{justify-content:center}
.am-head .eyebrow::before{display:none}
.am-g{
  display:grid;grid-template-columns:repeat(6,1fr);
  background:rgba(184,145,74,.04);border:1px solid rgba(184,145,74,.07);gap:1px;
}
.ai{
  background:var(--k2);padding:32px 20px;text-align:center;
  transition:background .4s,transform .4s;cursor:none;
}
.ai:hover{background:rgba(184,145,74,.07);transform:translateY(-3px)}
.ai-ic{font-size:26px;margin-bottom:12px}
.ai-n{
  font-family:'Cinzel',serif;font-size:7px;letter-spacing:2px;
  color:var(--wf);text-transform:uppercase;line-height:1.4;
}

/* ═══ LOCATION ═══ */
#location{background:var(--k)}
.loc-g{display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:start}
.loc-items{margin-top:40px;display:flex;flex-direction:column;gap:0}
.li{
  display:flex;gap:20px;padding:22px 0;
  border-bottom:1px solid rgba(184,145,74,.07);
}
.li:last-child{border:none}
.li-ic{
  width:44px;height:44px;border:1px solid rgba(184,145,74,.2);
  border-radius:50%;display:flex;align-items:center;justify-content:center;
  font-size:18px;flex-shrink:0;
}
.li-title{
  font-family:'Cinzel',serif;font-size:7px;letter-spacing:3px;
  color:var(--g);text-transform:uppercase;margin-bottom:6px;
}
.li-val{font-size:13px;line-height:1.5}
.dist-g{
  display:grid;grid-template-columns:1fr 1fr;gap:12px;
}
.dg{
  background:rgba(184,145,74,.04);border:1px solid rgba(184,145,74,.09);
  padding:22px;
}
.dg-km{
  font-family:'Cormorant Garamond',serif;font-size:42px;
  color:var(--g);font-weight:300;line-height:1;
}
.dg-km span{font-size:16px}
.dg-from{font-size:10px;color:var(--wm);margin-top:4px;letter-spacing:1px}
.price-badge{
  margin-top:20px;padding:28px 32px;
  background:rgba(184,145,74,.05);border:1px solid rgba(184,145,74,.12);
}
.pb-label{font-size:12px;color:var(--wm);margin-bottom:4px}
.pb-price{
  font-family:'Cormorant Garamond',serif;font-size:58px;
  color:var(--g);font-weight:300;line-height:1;
}
.pb-price span{font-size:16px;color:var(--wm)}
.pb-note{font-size:10px;color:var(--wf);margin-top:6px}
.landmarks{
  margin-top:20px;padding:24px 28px;
  background:rgba(184,145,74,.03);border:1px solid rgba(184,145,74,.07);
}
.lm-title{
  font-family:'Cinzel',serif;font-size:7px;letter-spacing:3px;
  color:var(--g);text-transform:uppercase;margin-bottom:16px;
}
.lm-list{
  display:flex;flex-direction:column;gap:10px;
}
.lm-item{
  display:flex;align-items:center;gap:12px;
  font-size:12px;color:var(--wm);
}
.lm-item::before{content:'';width:4px;height:4px;background:var(--g);border-radius:50%;flex-shrink:0}

/* ═══ REVIEWS ═══ */
#reviews{background:var(--k2);text-align:center}
.rv-h{margin-bottom:60px}
.rv-h .eyebrow{justify-content:center}
.rv-h .eyebrow::before{display:none}
.rv-scroll{
  display:flex;gap:20px;overflow-x:auto;padding-bottom:8px;
  scrollbar-width:none;
}
.rv-scroll::-webkit-scrollbar{display:none}
.rc{
  background:rgba(184,145,74,.04);border:1px solid rgba(184,145,74,.09);
  padding:40px 36px;min-width:360px;text-align:left;flex-shrink:0;
}
.rc-stars{color:var(--g);font-size:14px;letter-spacing:5px;margin-bottom:20px}
.rc-text{
  font-family:'Cormorant Garamond',serif;font-size:18px;font-style:italic;
  color:var(--wm);line-height:1.7;margin-bottom:24px;
}
.rc-auth{
  font-family:'Cinzel',serif;font-size:7px;letter-spacing:3px;
  color:var(--g);text-transform:uppercase;
}

/* ═══ CTA ═══ */
#cta{
  position:relative;min-height:520px;
  display:flex;align-items:center;justify-content:center;
  text-align:center;overflow:hidden;
}
#ctabg{
  position:absolute;inset:0;
  background:url('data:image/jpeg;base64,') center/cover;
  filter:brightness(.2) saturate(.5);
}
.cta-c{position:relative;z-index:2;padding:0 24px}
.cta-c .H{font-size:clamp(56px,7vw,100px)}
.cta-btn{
  display:inline-block;margin-top:44px;
  font-family:'Cinzel',serif;font-size:10px;letter-spacing:5px;
  text-decoration:none;color:var(--k);background:var(--g);
  padding:20px 60px;text-transform:uppercase;
  transition:background .3s,transform .3s,box-shadow .3s;
}
.cta-btn:hover{
  background:var(--gl);transform:translateY(-2px);
  box-shadow:0 20px 56px rgba(184,145,74,.3);
}

/* ═══ FOOTER ═══ */
footer{
  background:var(--k2);border-top:1px solid rgba(184,145,74,.08);
  padding:80px 0 40px;
}
.fg{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:56px;margin-bottom:64px}
.fl-logo{
  font-family:'Cinzel Decorative',serif;font-size:18px;
  letter-spacing:4px;color:var(--g);margin-bottom:20px;
}
.fl-desc{font-size:12px;color:var(--wm);line-height:1.8;margin-bottom:24px}
.fl-soc{display:flex;gap:10px}
.fs{
  width:38px;height:38px;border:1px solid rgba(184,145,74,.22);border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  text-decoration:none;color:var(--g);font-size:12px;font-weight:400;
  transition:background .3s,transform .3s;
}
.fs:hover{background:var(--g);color:var(--k);transform:translateY(-2px)}
.fc-t{
  font-family:'Cinzel',serif;font-size:7px;letter-spacing:3px;
  color:var(--g);text-transform:uppercase;margin-bottom:20px;
}
.fc-l{list-style:none;display:flex;flex-direction:column;gap:10px}
.fc-l a{font-size:12px;color:var(--wm);text-decoration:none;transition:color .3s}
.fc-l a:hover{color:var(--w)}
.fb{
  border-top:1px solid rgba(184,145,74,.07);padding-top:28px;
  display:flex;justify-content:space-between;align-items:center;
}
.fc{font-size:10px;color:rgba(240,234,216,.2);letter-spacing:1px}
.fa{
  font-family:'Cinzel',serif;font-size:7px;letter-spacing:4px;
  color:var(--g);display:flex;align-items:center;gap:10px;
}
.fa::before,.fa::after{content:'★';color:rgba(184,145,74,.4)}

/* ═══ GOLD RULE ═══ */
.gr{
  width:100%;height:1px;
  background:linear-gradient(to right,transparent,var(--g),transparent);
  opacity:.18;
}

/* ═══ KEYFRAMES ═══ */
@keyframes fup{to{opacity:1;transform:translateY(0)}}
@keyframes sli{to{opacity:1;transform:translateX(0)}}
</style>
</head>
<body>

<div id="C"></div>
<div id="CR"></div>
<canvas id="SC"></canvas>

<main>

<!-- NAV -->
<nav id="nav">
  <a href="#" class="nlogo">PERSENK</a>
  <ul class="nl">
    <li><a href="#lobby">Hotel</a></li>
    <li><a href="#rooms">Rooms</a></li>
    <li><a href="#spa">Spa</a></li>
    <li><a href="#dining">Dining</a></li>
    <li><a href="#offers">Offers</a></li>
    <li><a href="#location">Location</a></li>
  </ul>
  <a href="https://www.book.persenk.eu/?lng=en-GB" class="nb" target="_blank">Book Now</a>
</nav>

<!-- HERO -->
<section id="hero">
  <div id="hbg"></div>
  <div class="hvig"></div>
  <div class="hc">
    <div class="ht-eyebrow">Five Star Spa Hotel &nbsp;·&nbsp; Devin, Bulgaria</div>
    <h1 class="ht">
      Persenk
      <em>Spa Hotel</em>
    </h1>
    <p class="ht-sub">Luxury &nbsp;·&nbsp; Reimagined 2025 &nbsp;·&nbsp; Rhodope Mountains</p>
    <div class="ht-line">
      <span>★★★★★</span>
    </div>
  </div>
  <div class="hscroll">
    <span>Scroll</span>
    <div class="hscroll-line"></div>
  </div>
</section>

<!-- TICKER -->
<div class="ticker">
  <div class="ticker-t">
    <span>Five-Star Hospitality</span><span>Luxury Spa Retreat</span><span>Rhodope Mountains</span>
    <span>Mineral Waters</span><span>7 Restaurants</span><span>Thermal Aquapark</span>
    <span>Devin Bulgaria</span><span>Reopened July 2025</span>
    <span>Five-Star Hospitality</span><span>Luxury Spa Retreat</span><span>Rhodope Mountains</span>
    <span>Mineral Waters</span><span>7 Restaurants</span><span>Thermal Aquapark</span>
    <span>Devin Bulgaria</span><span>Reopened July 2025</span>
  </div>
</div>

<!-- ENTRANCE / BRAND -->
<section id="entrance">
  <div class="ent-grid">
    <div class="ent-img rl">
      <img src="data:image/jpeg;base64," alt="Persenk Entrance">
    </div>
    <div class="ent-content rr">
      <div class="ent-stars">★ ★ ★ ★ ★</div>
      <div class="ent-quote">
        Where <em>mountain majesty</em><br>becomes your daily view
      </div>
      <div class="ent-body">
        Persenk Spa Hotel combines modern urban architecture — distinguished by style, comfort and functionality — with a harmonious integration of the Rhodope Mountains' natural beauty. Completely renovated and reopened July 2025, setting a new benchmark in mountain luxury.
      </div>
      <div class="ent-stats">
        <div class="es rv d1"><div class="es-n">5★</div><div class="es-l">Star Rating</div></div>
        <div class="es rv d2"><div class="es-n">129</div><div class="es-l">Rooms & Suites</div></div>
        <div class="es rv d3"><div class="es-n">7</div><div class="es-l">Restaurants</div></div>
        <div class="es rv d4"><div class="es-n">710</div><div class="es-l">Metres Above Sea</div></div>
      </div>
    </div>
  </div>
</section>

<!-- LOBBY FULL-BLEED -->
<section id="lobby" style="padding:0">
  <div class="lobby-full rv">
    <img src="data:image/jpeg;base64," alt="Grand Lobby" style="display:block">
    <div class="lobby-over"></div>
    <div class="lobby-title rv">
      <div class="eyebrow">The Grand Lobby</div>
      <div class="H" style="font-size:clamp(40px,5vw,72px)">Marble. Art.<br><em>Magnificence.</em></div>
    </div>
    <div class="lobby-badge rv">
      <div class="lb-n">2025</div>
      <div class="lb-l">Fully<br>Renovated</div>
    </div>
  </div>
  <!-- Corridor strip -->
  <div style="height:320px;overflow:hidden;position:relative">
    <img src="data:image/jpeg;base64," alt="Hotel Corridor" style="width:100%;height:100%;object-fit:cover;filter:brightness(.55) saturate(.7);display:block">
    <div style="position:absolute;inset:0;background:linear-gradient(to right,rgba(5,5,12,.8),transparent 40%,transparent 60%,rgba(5,5,12,.8));display:flex;align-items:center;padding:0 80px">
      <div style="max-width:400px">
        <div class="eyebrow rv">Lobby Bar</div>
        <div class="H rv" style="font-size:clamp(30px,3.5vw,48px)">A corridor<br>of <em>light</em></div>
      </div>
    </div>
  </div>
</section>

<!-- ROOMS -->
<section id="rooms">
  <div class="W">
    <div class="rooms-l">
      <div class="rl">
        <div class="room-hero">
          <img src="data:image/jpeg;base64," alt="Guest Room">
          <div class="room-tag">Signature Room</div>
        </div>
      </div>
      <div class="rr">
        <div class="eyebrow">Accommodation</div>
        <h2 class="H">Rooms &<br><em>Apartments</em></h2>
        <p class="body" style="margin-top:24px">Our rooms are the perfect combination of coziness, convenience and elegance. Every window frames a spectacular view — the Rhodope Mountains, the city, or the tranquil garden.</p>
        <div class="room-feats">
          <div class="rf">Flat-screen TV with satellite channels</div>
          <div class="rf">Private bathroom with bath & shower</div>
          <div class="rf">Mini-bar, air conditioning & Wi-Fi</div>
          <div class="rf">Mountain or garden panoramic views</div>
          <div class="rf">Deluxe, Panorama & Family Apartments available</div>
          <div class="rf">VIP Suites with personalised service</div>
        </div>
        <a href="https://persenk.eu/en/accommodation/" target="_blank" class="oc-link" style="margin-top:36px;display:inline-flex">View All Rooms</a>
      </div>
    </div>
  </div>
</section>

<!-- SPA CENTER -->
<section id="spa" style="padding:0">
  <div class="spa-hero">
    <div class="spa-hero-bg"></div>
    <div class="spa-hero-content">
      <div class="eyebrow rv" style="color:var(--gl)">Wellness & Spa</div>
      <h2 class="H rv" style="font-size:clamp(52px,7vw,100px);max-width:700px">The Persenk<br><em>Spa Center</em></h2>
      <p class="body rv" style="margin-top:28px">Amidst the tranquility and grandeur of the Rhodope Mountains — created to transform harmony into a way of life. Inspired by the natural power of the mountain.</p>
    </div>
  </div>

  <div class="spa-panels">
    <div class="spa-panel rv d1">
      <img src="data:image/jpeg;base64," alt="Indoor Pool & Jacuzzi">
      <div class="spa-panel-over">
        <div class="sp-eyebrow">Wellness</div>
        <div class="sp-name">Indoor Pool<br>& Jacuzzi</div>
        <div class="sp-desc">Crystal-clear mineral waters under a glass skylight. Pure restoration.</div>
      </div>
    </div>
    <div class="spa-panel rv d2">
      <img src="data:image/jpeg;base64," alt="Mineral Water Pool">
      <div class="spa-panel-over">
        <div class="sp-eyebrow">Therapy</div>
        <div class="sp-name">Mineral<br>Water Pools</div>
        <div class="sp-desc">Bedenska mineral waters renowned for their healing qualities.</div>
      </div>
    </div>
    <div class="spa-panel rv d3">
      <img src="data:image/jpeg;base64," alt="Finnish Sauna">
      <div class="spa-panel-over">
        <div class="sp-eyebrow">Detox</div>
        <div class="sp-name">Finnish<br>Sauna</div>
        <div class="sp-desc">Handcrafted Nordic wood, warmth, silence. The art of letting go.</div>
      </div>
    </div>
    <div class="spa-panel rv d4">
      <img src="data:image/jpeg;base64," alt="Salt Room">
      <div class="spa-panel-over">
        <div class="sp-eyebrow">Halotherapy</div>
        <div class="sp-name">Salt Room<br>— Relax</div>
        <div class="sp-desc">Himalayan salt microclimate for body and respiratory healing.</div>
      </div>
    </div>
  </div>
</section>

<!-- POOL SPLIT -->
<section id="pool" style="padding:0">
  <div class="pool-split">
    <div class="ps-img rl">
      <img src="data:image/jpeg;base64," alt="Main Indoor Pool">
    </div>
    <div class="ps-content rr">
      <div class="eyebrow">Aquatic Wellness</div>
      <h2 class="H" style="font-size:clamp(36px,4vw,58px)">The Grand<br><em>Indoor Pool</em></h2>
      <p class="body" style="margin-top:24px">Beneath dramatic slanted glass architecture, the main indoor pool is a sanctuary of movement and stillness — warmed by mineral-rich Devin waters.</p>
      <div class="ps-detail">
        <div class="pd"><div class="pd-icon">◈</div>Mineral-rich Devin Bedenska water</div>
        <div class="pd"><div class="pd-icon">◈</div>Glass-roof architecture with natural light</div>
        <div class="pd"><div class="pd-icon">◈</div>Jacuzzi & hydrotherapy jets</div>
        <div class="pd"><div class="pd-icon">◈</div>Sunloungers & poolside service</div>
        <div class="pd"><div class="pd-icon">◈</div>Children's pool available</div>
      </div>
    </div>
  </div>
</section>

<!-- DINING -->
<section id="dining">
  <div class="W">
    <div class="dining-intro">
      <div class="rl">
        <div class="eyebrow">Gastronomy</div>
        <h2 class="H">Dining &<br><em>Restaurants</em></h2>
      </div>
      <div class="rr">
        <p class="body" style="margin-bottom:28px">"Good food is just like poetry — it makes us feel alive and inspired." Seven restaurants and bars, each with its own character, together create an unforgettable culinary journey.</p>
        <a href="https://persenk.eu/en/about-us/restaurants-and-bars/" target="_blank" class="oc-link">Explore Dining</a>
      </div>
    </div>
  </div>
  <div class="dining-mosaic rv">
    <div class="dt">
      <img src="data:image/jpeg;base64," alt="Banquet Hall">
      <div class="dt-over" style="padding:36px 32px 28px">
        <div class="dt-label">Grand Banquet Hall — Crystal Chandeliers & Fine Dining</div>
      </div>
    </div>
    <div class="dt">
      <img src="data:image/jpeg;base64," alt="Lobby Bar">
      <div class="dt-over">
        <div class="dt-label">Lobby Bar</div>
      </div>
    </div>
    <div class="dt">
      <img src="data:image/jpeg;base64," alt="Rooftop">
      <div class="dt-over">
        <div class="dt-label">Rooftop Terrace Bar</div>
      </div>
    </div>
  </div>
  <div class="W">
    <div class="dining-7 rv">
      <div class="d7-num">7</div>
      <div class="d7-text">
        <div class="d7-title">Restaurants & Bars</div>
        <div class="d7-sub">Bulgarian & European cuisine, à la carte, lobby bar, pool bar, night bar, summer garden & rooftop terrace — every taste, every moment.</div>
      </div>
    </div>
  </div>
</section>

<!-- ROOFTOP TERRACE -->
<section id="rooftop">
  <div id="rtbg"></div>
  <div class="rt-content">
    <div class="rt-left rl">
      <div class="eyebrow">Open Air</div>
      <h2 class="H" style="font-size:clamp(44px,5.5vw,80px)">Rooftop<br><em>Terrace</em></h2>
      <p class="body" style="margin-top:24px">Panoramic mountain views, warm Rhodope evenings, and the sound of the valley below. The rooftop terrace is where the sky becomes your dining room.</p>
      <a href="https://persenk.eu/en/about-us/restaurants-and-bars/" target="_blank" class="oc-link" style="margin-top:32px;display:inline-flex">Reserve a Table</a>
    </div>
    <div class="rt-right rr">
      <div class="rt-feat rv d1">
        <div class="rtf-icon">🏔</div>
        <div>
          <div class="rtf-name">Panoramic Mountain Views</div>
          <div class="rtf-desc">360° views of the Rhodope Mountains and the town of Devin</div>
        </div>
      </div>
      <div class="rt-feat rv d2">
        <div class="rtf-icon">🍹</div>
        <div>
          <div class="rtf-name">Bar & Refreshments</div>
          <div class="rtf-desc">Cocktails, local wines & craft beverages served throughout the day</div>
        </div>
      </div>
      <div class="rt-feat rv d3">
        <div class="rtf-icon">🛋</div>
        <div>
          <div class="rtf-name">Luxury Outdoor Lounge</div>
          <div class="rtf-desc">Pergola shade, wicker furniture, sunloungers & relaxation areas</div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- NIGHT BAR & ENTERTAINMENT -->
<section id="nightbar" style="padding:0">
  <div class="nb-split">
    <div class="nb-img rl">
      <img src="data:image/jpeg;base64," alt="Night Bar & Billiards">
    </div>
    <div class="nb-content rr">
      <div class="eyebrow">Evening & Entertainment</div>
      <h2 class="H" style="font-size:clamp(36px,4vw,56px)">Night Bar &<br><em>Billiards</em></h2>
      <p class="body" style="margin-top:24px">When the sun sets over the Rhodopes, Persenk comes alive. The night bar pulses with energy — a world of neon, music, and mountain-cooled evenings.</p>
      <div class="nb-list">
        <div class="nbl">Professional billiards table</div>
        <div class="nbl">Full cocktail & spirits bar</div>
        <div class="nbl">Bowling alley</div>
        <div class="nbl">Live music evenings</div>
        <div class="nbl">Night club atmosphere</div>
        <div class="nbl">Disco ball & ambient lighting</div>
      </div>
    </div>
  </div>
</section>

<!-- OFFERS -->
<section id="offers">
  <div class="W">
    <div class="offers-head">
      <div class="rv">
        <div class="eyebrow">Packages</div>
        <h2 class="H">Current <em>Offers</em></h2>
      </div>
      <a href="https://persenk.eu/en/offers/" target="_blank" class="oc-link rv" style="display:inline-flex">All Offers</a>
    </div>
    <div class="offers-g">
      <div class="oc rv d1">
        <div class="oc-tag">Best Value</div>
        <div class="oc-n">3 = 4<br>Stay & Save</div>
        <div class="oc-d">Book 3 nights and we'll give you the fourth night for free. The perfect mountain escape.</div>
        <a href="https://persenk.eu/en/3-4-book-3-nights-and-well-give-you-the-fourth-one-for-free/" target="_blank" class="oc-link">Discover</a>
      </div>
      <div class="oc rv d2">
        <div class="oc-tag">Seasonal</div>
        <div class="oc-n">Spring<br>in Devin</div>
        <div class="oc-d">A curated spring retreat — spa treatments, fine dining, and blooming mountain trails.</div>
        <a href="https://persenk.eu/en/spring-in-devin/" target="_blank" class="oc-link">Discover</a>
      </div>
      <div class="oc rv d3">
        <div class="oc-tag">Weekend</div>
        <div class="oc-n">Unforgettable<br>Weekends</div>
        <div class="oc-d">Two-night luxury retreat packages for those who need a true reset.</div>
        <a href="https://persenk.eu/en/unforgettable-weekends/" target="_blank" class="oc-link">Discover</a>
      </div>
      <div class="oc rv d1">
        <div class="oc-tag">Midweek</div>
        <div class="oc-n">Weekday<br>Getaway</div>
        <div class="oc-d">Escape the city midweek and enjoy the Rhodopes at exceptional rates.</div>
        <a href="https://persenk.eu/en/weekday-getaway/" target="_blank" class="oc-link">Discover</a>
      </div>
      <div class="oc rv d2">
        <div class="oc-tag">Summer 2026</div>
        <div class="oc-n">Aqua<br>Vacation</div>
        <div class="oc-d">Full aquapark access and family packages for a summer to remember.</div>
        <a href="https://persenk.eu/en/aqua-vacation-2026/" target="_blank" class="oc-link">Discover</a>
      </div>
      <div class="oc rv d3">
        <div class="oc-tag">Early Booking</div>
        <div class="oc-n">Five Star<br>Gift</div>
